# Copy to .env and fill in. NEVER commit .env.
# ------------------------------------------------------------------ LLM provider
# One of: gemini | openai | anthropic | ollama | mock   (mock = offline rule-based stand-in, used by CI/tests)
LLM_PROVIDER=gemini
# Optional model override for whichever provider is active (leave empty for the defaults below).
LLM_MODEL=
GEMINI_API_KEY=AQ.Ab8RN6LbFSMLk_kNSJ4KiUvq7Wcqk62iioCgnaNzsdcdTMNYgA
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# NOTE: model names change often. If a provider answers "model not found", check its docs and edit the *_MODEL line.

# ------------------------------------------------------------------ app / security
ENVIRONMENT=dev                       # anything other than "dev" REFUSES to start with the default JWT secret
JWT_SECRET=change-me-in-production    # python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_EMAILS=                         # comma separated; these emails get the admin role on signup
ANON_SALT=change-me-too               # salt for anonymised student ids in the admin view
ADMIN_MIN_GROUP=5                     # hide per-student admin views/exports for batches smaller than this
BACKEND_URL=http://localhost:8000     # used by the Streamlit frontend
DATABASE_URL=sqlite:///./prepwise.db

# ------------------------------------------------------------------ RAG / NLP / speech
EMBEDDING_BACKEND=sentence-transformers   # or "hash" (offline fallback, not semantic)
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=chroma                       # or "memory"
SPACY_MODEL=en_core_web_sm
WHISPER_MODEL=base                        # tiny | base | small ...
ENABLE_TRANSFORMER_SENTIMENT=true
TTS_ENABLED=true
PDF_FONT_PATH=                            # path to a Unicode TTF (Noto Sans Tamil/Devanagari) for non-English PDFs

# ------------------------------------------------------------------ code sandbox
CODE_RUNNER=local                         # local | judge0
SANDBOX_TIMEOUT_SEC=4
SANDBOX_MEMORY_MB=256
JUDGE0_API_KEY=
